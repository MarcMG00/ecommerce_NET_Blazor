<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Ecommerce.Web.styles.css"]" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <HeadOutlet @rendermode="Mode" />
</head>

<body>
    <Routes @rendermode="Mode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Toda la app es interactiva (servidor). Sin prerender: así la carga de datos se hace una sola vez.
    private static readonly IComponentRenderMode Mode = new InteractiveServerRenderMode(prerender: false);
}
